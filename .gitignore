# Xcode
*.xcworkspace
*.xcuserdata
*.xcscmblueprint
*.xccheckout
DerivedData/
build/
*.xcodeproj
!*.xcodeproj/project.xcworkspace/xcshareddata/

# SPM
.build/
.swiftpm/
Packages/*/.build/

# macOS
.DS_Store
Thumbs.db
*.dmg
*.app

# 构建产物不入库：发版附件只存在于 GitHub Release
release/

# Swift
*.swp
*.o

# Signing & Provisioning
*.cer
*.p12
*.mobileprovision
*.provisionprofile

# Code Coverage
*.xcresult
*.gcda
*.gcno

# Archives
*.zip
*.tar.gz

# IDE
.idea/
.vscode/
*.swp
*~

# Temporary
*.tmp
*.bak
*.log

# Build output (临时构建产物，统一使用 release/vX.Y.Z/)
output/

# Release 归档清理规则
# 保留 release/vX.Y.Z/*.dmg + *.sha256 + BUILD_INFO.json + versions.json
# 忽略解压产物、软链、系统文件
release/latest/
release/*/*.app/
release/*/.DS_Store
release/.DS_Store
release/manual-*/

# 本地实验打包产物（--experimental 模式，release/exp-*/），不入库
release/exp-*/

# Local UI validation evidence and compiler intermediates
release/validation-*/
release/validation-format.json
release/text-preview-*.png
release/text-committed-*.png
